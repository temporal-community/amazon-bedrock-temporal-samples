# Copy to .env and fill in values for an AWS-hosted Temporal Cloud namespace.
AWS_REGION=us-west-2
TEMPORAL_ADDRESS=<namespace>.<account>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_API_KEY=<temporal-cloud-api-key>
# Use a new build ID for each notebook deployment run.
TEMPORAL_BUILD_ID=finance-v1
# Pick a stable, unique value of at least five characters for this deployment.
TEMPORAL_INVOKE_EXTERNAL_ID=<unique-external-id>
